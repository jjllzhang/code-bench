+#[path = "measurement.rs"]
+mod measurement;
+
+use std::{mem::size_of, time::{Duration, Instant}};
+use plonkish_backend::{
+    pcs::multilinear::{encoding_bench_rfc_encode, encoding_bench_rfc_table},
+    util::{
+        arithmetic::PrimeField,
+        avx_int_types::u64::Blazeu64,
+        code::{Brakedown, BrakedownSpec3, LinearCodes, Permutation, encode_bits},
+        goldilocksMont::GoldilocksMont,
+        new_fields::Mersenne127,
+    },
+};
+use rand::{RngCore, SeedableRng, rngs::StdRng};
+use rand_chacha::ChaCha8Rng;
+
+fn rfc<F: PrimeField>(n: usize, c: usize) {
+    let mut rng = StdRng::seed_from_u64(112);
+    let msg: Vec<F> = (0..n).map(|_| F::random(&mut rng)).collect();
+    let log_rate = c.ilog2() as usize;
+    let start = Instant::now();
+    let table = encoding_bench_rfc_table(n, log_rate);
+    let setup = measurement::ms(start);
+    println!("GEOMETRY {n} {} {}", n*c, n*size_of::<F>());
+    measurement::measure(setup, n*c, || msg.clone(), |m| {
+        encoding_bench_rfc_encode(m, log_rate, &table)
+    }, |v| (v.len(), v.iter().any(|&x| x != F::ZERO)));
+}
+
+fn sdig<F: PrimeField>(n: usize) {
+    let mut msg_rng = StdRng::seed_from_u64(112);
+    let message: Vec<F> = (0..n).map(|_| F::random(&mut msg_rng)).collect();
+    let start = Instant::now();
+    let encoder = Brakedown::<F>::encoding_bench_single::<BrakedownSpec3>(
+        n, 128, ChaCha8Rng::seed_from_u64(113)
+    );
+    let setup = measurement::ms(start);
+    assert_eq!(encoder.row_len(), n);
+    let length = encoder.codeword_len();
+    let prepare = |word: &mut [F]| {
+        word[..n].copy_from_slice(&message);
+        // The original scatter accumulates into its destination.
+        word[n..].fill(F::ZERO);
+    };
+    if n <= 1024 {
+        let mut fresh = vec![F::ZERO; length];
+        fresh[..n].copy_from_slice(&message);
+        encoder.encode(&mut fresh);
+        let mut reused = vec![F::ZERO; length];
+        assert!(fresh[n..].iter().any(|&x| x != F::ZERO));
+        for _ in 0..2 {
+            prepare(&mut reused);
+            encoder.encode(&mut reused);
+            assert_eq!(reused, fresh);
+        }
+    }
+    let buffer = std::cell::RefCell::new(Some(vec![F::ZERO; length]));
+    println!("PARAM profile=BrakedownSpec3 base_limit=128");
+    println!("GEOMETRY {n} {length} {}", n*size_of::<F>());
+    measurement::measure(setup, length, || {
+        let mut word = buffer.borrow_mut().take().unwrap();
+        prepare(&mut word);
+        word
+    }, |mut word| {
+        encoder.encode(&mut word);
+        word
+    }, |word| {
+        let result = (word.len(), word.iter().any(|&x| x != F::ZERO));
+        buffer.replace(Some(word));
+        result
+    });
+}
+
+fn raa(n: usize, c: usize) {
+    let mut rng = StdRng::seed_from_u64(112);
+    let msg: Vec<Blazeu64> = (0..n).map(|_| Blazeu64 { value: rng.next_u64() }).collect();
+    let start = Instant::now();
+    let mut rng = ChaCha8Rng::seed_from_u64(113);
+    let permutations = Permutation {
+        permutation1: Permutation::get_permutation(&mut rng, n*c),
+        permutation2: Permutation::get_permutation(&mut rng, n*c),
+        permutation3: vec![],
+        puncturing: Default::default(),
+    };
+    let setup = measurement::ms(start);
+    println!("GEOMETRY {n} {} {}", n*c, n*size_of::<Blazeu64>());
+    measurement::measure(setup, n*c, || msg.clone(), |m| {
+        encode_bits(m, &permutations, c, &mut Duration::default())
+    }, |v| (v.len(), v.iter().any(|x| x.value != 0)));
+}
+
+fn main() {
+    let argv: Vec<_> = std::env::args().skip(1).collect();
+    let [operation, field, k, c] = argv.as_slice() else { panic!("operation field log_k inverse_rate") };
+    let n = 1 << k.parse::<usize>().unwrap();
+    if operation == "brakedown" {
+        return match field.as_str() {
+            "goldilocks" => sdig::<GoldilocksMont>(n),
+            "m127" => sdig::<Mersenne127>(n),
+            _ => panic!("unknown Brakedown field"),
+        }
+    }
+    let c = c.parse().unwrap();
+    match (operation.as_str(), field.as_str()) {
+        ("basefold", "goldilocks") => rfc::<GoldilocksMont>(n,c),
+        ("basefold", "m127") => rfc::<Mersenne127>(n,c),
+        ("raa", "bf64") => raa(n,c),
+        _ => panic!("unknown encoder"),
+    }
+}
