+/// Encode the native coefficient message with the original 64-symbol RS base case.
+#[doc(hidden)]
+pub fn encoding_bench_rfc_encode<F: PrimeField>(
+    message: Vec<F>, log_rate: usize, table: &Vec<Vec<F>>,
+) -> Vec<F> {
+    let coeffs = Type2Polynomial { poly: message };
+    let base = encode_rs_basecode(&coeffs, 1 << log_rate, 64);
+    evaluate_over_foldable_domain_2(6 + log_rate, log_rate, base, table).poly
+}
