 mod tests {
     use super::*;
     use crate::binary_fields::BinaryElem32;
+
+    #[test]
+    fn gallager_strips_and_seed() {
+        let (m, c, d) = (256, 8, 64);
+        let h = ExpanderMatrix::<BinaryElem32>::new_gallager_binary_with_seed(m, c, d, 42).unwrap();
+        assert_eq!(h.num_constraints(), m * c / d);
+        assert_eq!(h.left_degree(), c);
+        let mut degrees = vec![0; m];
+        for strip in h.constraints.chunks_exact(m / d) {
+            let mut seen = vec![0; m];
+            for row in strip {
+                assert_eq!(row.len(), d);
+                for &(col, coeff) in row {
+                    assert!(col < m);
+                    assert_eq!(coeff, BinaryElem32::one());
+                    seen[col] += 1;
+                    degrees[col] += 1;
+                }
+            }
+            assert!(seen.iter().all(|&n| n == 1));
+        }
+        assert!(degrees.iter().all(|&n| n == c));
+        for (row, entries) in h.constraints[..m / d].iter().enumerate() {
+            assert_eq!(
+                entries.iter().map(|&(col, _)| col).collect::<Vec<_>>(),
+                (row * d..(row + 1) * d).collect::<Vec<_>>()
+            );
+        }
+        let again =
+            ExpanderMatrix::<BinaryElem32>::new_gallager_binary_with_seed(m, c, d, 42).unwrap();
+        assert_eq!(h.constraints, again.constraints);
+        let other =
+            ExpanderMatrix::<BinaryElem32>::new_gallager_binary_with_seed(m, c, d, 43).unwrap();
+        assert_ne!(h.constraints[m / d..], other.constraints[m / d..]);
+    }
+
+    #[test]
+    fn gallager_rejects_invalid_dimensions() {
+        for (m, c, d) in [
+            (0, 8, 64),
+            (64, 0, 64),
+            (64, 8, 0),
+            (65, 8, 64),
+            (16, 8, 64),
+            (usize::MAX, 2, 1),
+            (usize::MAX / 2, 1, 1),
+            (1, usize::MAX, 1),
+        ] {
+            assert!(
+                ExpanderMatrix::<BinaryElem32>::new_gallager_binary_with_seed(m, c, d, 0).is_err()
+            );
+        }
+    }
 
