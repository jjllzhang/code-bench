 impl<T: BinaryElem> ExpanderMatrix<T> {
+    /// Binary Gallager ensemble with `c` strips of `msg_len / d` rows.
+    /// The first strip groups the identity column ordering into rows of size
+    /// `d`; each remaining strip independently shuffles the ORIGINAL columns.
+    /// Thus each column occurs exactly once per strip (not a socket shuffle).
+    ///
+    /// Uniform permutations describe the ideal ensemble. `StdRng` seeded by
+    /// only 64 bits is a reproducible implementation, NOT a certified sampler
+    /// for that ensemble or a certificate of finite-length code distance.
+    pub fn new_gallager_binary_with_seed(
+        msg_len: usize,
+        c: usize,
+        d: usize,
+        seed: u64,
+    ) -> Result<Self, &'static str> {
+        use rand::seq::SliceRandom;
+
+        if msg_len == 0 || c == 0 || d == 0 || msg_len % d != 0 {
+            return Err("positive dimensions and msg_len divisible by d required");
+        }
+        let edges = msg_len.checked_mul(c).ok_or("edge count overflow")?;
+        let rows = (msg_len / d).checked_mul(c).ok_or("row count overflow")?;
+        // Bound every allocation and the aggregate edge storage before trying
+        // to allocate. Fallible reservations also report allocator limits.
+        for bytes in [
+            edges.checked_mul(std::mem::size_of::<(usize, T)>()),
+            rows.checked_mul(std::mem::size_of::<Vec<(usize, T)>>()),
+            msg_len.checked_mul(std::mem::size_of::<usize>()),
+        ] {
+            if bytes.is_none_or(|n| n > isize::MAX as usize) {
+                return Err("graph resource limit");
+            }
+        }
+        let mut constraints = Vec::new();
+        constraints
+            .try_reserve_exact(rows)
+            .map_err(|_| "graph resource limit")?;
+        let mut columns = Vec::new();
+        columns
+            .try_reserve_exact(msg_len)
+            .map_err(|_| "graph resource limit")?;
+        let mut rng = StdRng::seed_from_u64(seed);
+        for strip in 0..c {
+            columns.clear();
+            columns.extend(0..msg_len);
+            if strip != 0 {
+                columns.shuffle(&mut rng);
+            }
+            for chunk in columns.chunks_exact(d) {
+                let mut row = Vec::new();
+                row.try_reserve_exact(d)
+                    .map_err(|_| "graph resource limit")?;
+                row.extend(chunk.iter().map(|&col| (col, T::one())));
+                row.sort_unstable_by_key(|&(col, _)| col);
+                constraints.push(row);
+            }
+        }
+        Ok(Self {
+            msg_len,
+            constraints,
+            c,
+        })
+    }
